<!doctype html>
<html lang="bn">
<head>
<meta charset="utf-8"><meta name="viewport" content="width=device-width, initial-scale=1">
<meta name="description" content="AZIZUL-এর ব্যক্তিগত পরিচিতি ও যোগাযোগের ওয়েবসাইট">
<title>AZIZUL | ব্যক্তিগত ওয়েবসাইট</title>
<style>
:root{--bg:#080d18;--panel:#111a2b;--ink:#f4f7ff;--muted:#aab5ca;--accent:#70d6c2;--line:#26334b}
*{box-sizing:border-box}html{scroll-behavior:smooth}body{margin:0;background:var(--bg);color:var(--ink);font-family:system-ui,-apple-system,"Noto Sans Bengali",sans-serif;line-height:1.75}
a{color:inherit;text-decoration:none}.wrap{width:min(1060px,92%);margin:auto}
header{position:sticky;top:0;background:#080d18eF;backdrop-filter:blur(12px);border-bottom:1px solid var(--line);z-index:5}
nav{min-height:70px;display:flex;align-items:center;justify-content:space-between;gap:18px}.brand{font-weight:900;letter-spacing:2px;color:var(--accent);font-size:1.25rem}.links{display:flex;gap:22px;color:var(--muted);font-size:.95rem}
.hero{padding:76px 0 65px;background:radial-gradient(ellipse at 80% 15%,#17413e 0,transparent 38%),linear-gradient(135deg,#0d1728,#080d18)}
.hero-grid{display:grid;grid-template-columns:1.3fr .8fr;gap:42px;align-items:center}.tag{color:var(--accent);font-weight:700;letter-spacing:1px}
h1{font-size:clamp(3rem,8vw,5.5rem);line-height:1.08;margin:12px 0}.lead{font-size:1.18rem;color:var(--muted);max-width:590px}
.portrait{width:min(330px,100%);aspect-ratio:4/5;object-fit:cover;object-position:center 25%;border-radius:28px;border:1px solid #5a8c83;box-shadow:0 24px 70px #0008;justify-self:center}
.actions{display:flex;gap:12px;flex-wrap:wrap;margin-top:26px}.btn{padding:11px 19px;border-radius:12px;background:var(--accent);color:#06211d;font-weight:800}.btn.secondary{background:transparent;border:1px solid #607087;color:var(--ink)}
section{padding:58px 0}.heading{font-size:1.9rem;margin:0 0 8px}.muted{color:var(--muted);margin:0 0 24px}
.card{padding:25px;border-radius:18px;background:var(--panel);border:1px solid var(--line)}.cards{display:grid;grid-template-columns:repeat(3,1fr);gap:16px}.card h3{margin:0 0 8px;color:var(--accent)}.card p{margin:0;color:var(--muted)}
.contact-list{display:flex;gap:14px;flex-wrap:wrap}.contact-list a{border:1px solid var(--line);background:var(--panel);padding:14px 18px;border-radius:12px;color:var(--accent);font-weight:700}
footer{border-top:1px solid var(--line);padding:24px 0;color:var(--muted);text-align:center}
@media(max-width:720px){.hero-grid{grid-template-columns:1fr;text-align:center}.portrait{grid-row:1;width:220px}.lead{margin:auto}.actions{justify-content:center}.cards{grid-template-columns:1fr}.links{gap:12px;font-size:.84rem}}
</style>
</head>
<body>
<header><div class="wrap"><nav><a class="brand" href="#">AZIZUL</a><div class="links"><a href="#about">পরিচিতি</a><a href="#work">ব্যবসা</a><a href="#contact">যোগাযোগ</a></div></nav></div></header>
<main>
<section class="hero"><div class="wrap hero-grid">
<div><div class="tag">স্বাগতম আমার ওয়েবসাইটে</div><h1>আমি <span style="color:var(--accent)">MD:AZIZUL</span></h1>
<p class="lead">আমি একজন ব্যবসায়ী। আমার কাজ, পরিচিতি এবং যোগাযোগের তথ্য জানতে এই ওয়েবসাইটে স্বাগতম।</p>
<div class="actions"><a class="btn" href="#contact">যোগাযোগ করুন</a><a class="btn secondary" href="#about">আমার সম্পর্কে</a></div></div>
<img class="portrait" src="data:image/png;base64," alt="AZIZUL-এর প্রোফাইল ছবি">
</div></section>
<section id="about"><div class="wrap"><h2 class="heading">আমার সম্পর্কে</h2><p class="muted">সংক্ষিপ্ত ব্যক্তিগত পরিচিতি</p>
<div class="card"><p>আসসালামু আলাইকুম। আমি MD:AZIZUL। আমি ব্যবসার সঙ্গে যুক্ত। সততা, বিশ্বাস এবং ভালো সেবাকে গুরুত্ব দিয়ে কাজ করার চেষ্টা করি। আমার সঙ্গে যোগাযোগ করতে নিচের নম্বরগুলো ব্যবহার করতে পারেন।</p></div></div></section>
<section id="work"><div class="wrap"><h2 class="heading">আমার কাজ</h2><p class="muted">ব্যবসা ও পেশাগত পরিচয়</p>
<div class="cards"><div class="card"><h3>ব্যবসা</h3><p>ব্যবসায়িক কার্যক্রম ও উদ্যোগের সঙ্গে যুক্ত।</p></div><div class="card"><h3>বিশ্বাস ও সেবা</h3><p>গ্রাহকের আস্থা ও সন্তুষ্টিকে গুরুত্ব দিই।</p></div><div class="card"><h3>যোগাযোগ</h3><p>প্রয়োজনে সরাসরি ফোন বা WhatsApp-এ যোগাযোগ করুন।</p></div></div></div></section>
<section id="contact"><div class="wrap"><h2 class="heading">যোগাযোগ করুন</h2><p class="muted">ফোনে অথবা WhatsApp-এ যোগাযোগ করতে পারেন</p>
<div class="contact-list"><a href="tel:+8801942852950">ফোন: 01942852950</a><a href="tel:+8801827760671">ফোন: 01827760671</a><a href="https://wa.me/8801942852950" target="_blank" rel="noopener">WhatsApp-এ মেসেজ</a></div></div></section>
</main>
<footer><div class="wrap">© <span id="year"></span> AZIZUL। সর্বস্বত্ব সংরক্ষিত।</div></footer>
<script>document.getElementById('year').textContent=new Date().getFullYear()</script>
</body></html>
